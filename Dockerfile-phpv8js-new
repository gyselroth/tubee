FROM php:8.2.35-fpm-alpine3.24

RUN apk add --no-cache \
        nodejs-libs \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        autoconf \
        build-base \
        curl \
        libtool \
        m4 \
        nodejs-dev \
        pkgconf \
    \
    # Install PHP Installer for Extensions (PIE)
    && curl -fsSL \
        https://github.com/php/pie/releases/latest/download/pie.phar \
        -o /usr/local/bin/pie \
    && chmod +x /usr/local/bin/pie \
    \
    # Build and install v8js against Alpine's V8
    && pie install standa/php-v8js --with-v8js=/usr \
    && docker-php-ext-enable v8js \
    \
    # Cleanup build dependencies
    && apk del .build-deps \
    && rm -rf /tmp/* /var/cache/apk/*
